# ==============================================================================
# INNODATA AUTOMATED TASK FACTORY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Supported Providers:
#   - 'mock'   : Dynamic local mock engine; runs completely offline without API keys.
#   - 'gemini' : Native Google Gemini API via official `google-genai` SDK.
#   - 'openai' : OpenAI & OpenAI-compatible providers via `openai` SDK.
LLM_PROVIDER=mock

# Default Model Name:
#   - Gemini: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
#   - OpenAI: gpt-4o, gpt-4o-mini, o1-preview, o3-mini
#   - OpenRouter/Groq: deepseek/deepseek-chat, llama-3.3-70b-versatile, etc.
MODEL_NAME=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. API Keys & Authentication
# ------------------------------------------------------------------------------
# Set the credential matching your selected LLM_PROVIDER.
# Gemini API Key (obtain from https://aistudio.google.com/):
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (obtain from https://platform.openai.com/):
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. OpenAI-Compatible Base URL (Optional)
# ------------------------------------------------------------------------------
# Route OpenAI client requests to custom or third-party inference endpoints:
#   - OpenRouter : https://openrouter.ai/api/v1
#   - Groq       : https://api.groq.com/openai/v1
#   - DeepSeek   : https://api.deepseek.com/v1
#   - LocalAI    : http://localhost:8080/v1
#   - Ollama     : http://localhost:11434/v1
#   - vLLM       : http://localhost:8000/v1
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Per-Call Override Options (Programmatic API Reference)
# ------------------------------------------------------------------------------
# `call_llm` supports per-call overrides for all parameters:
#   call_llm(
#       prompt="...",
#       system_prompt="...",
#       provider="openai",                    # Overrides Config.LLM_PROVIDER
#       model="gpt-4o",                       # Overrides Config.MODEL_NAME
#       temperature=0.2,                      # Controls sampling randomness
#       max_tokens=2048,                      # Limits response length
#       base_url="https://api.groq.com/openai/v1",  # Overrides Config.OPENAI_BASE_URL
#       api_key="...",                        # Per-call key override
#       max_retries=3,                        # Exponential backoff retry limit
#   )
